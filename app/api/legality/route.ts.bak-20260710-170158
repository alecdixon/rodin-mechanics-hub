            <tr><td style="padding:9px 0;color:#a1a1aa;width:150px;border-bottom:1px solid #27272a">Date</td><td style="padding:9px 0;border-bottom:1px solid #27272a">${escapeHtml(formatReportDate(payload.check_date))}</td></tr>
