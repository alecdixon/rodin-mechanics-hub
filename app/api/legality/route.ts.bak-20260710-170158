  wing_shims?: Partial<WingShims> | null;
  download_only?: boolean | null;
  items?: LegalityReportItem[];
};

type NormalisedLegalityEmailPayload = {
  check_id: string;
  car_id: number;
  car_name: string;
  driver: string;
  circuit: string;
  check_date: string;
  engineer_name: string;
  engineer_email: string;
